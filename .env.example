# TURN credentials are injected into the static build. Use short-lived credentials
# when your TURN provider supports them. Separate multiple URLs with commas.
VITE_TURN_URLS=stun:stun.cloudflare.com:3478,turn:turn.cloudflare.com:3478?transport=udp,turn:turn.cloudflare.com:3478?transport=tcp,turns:turn.cloudflare.com:5349?transport=tcp
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_SIGNALING_URL=https://twoway-signaling.example.workers.dev
